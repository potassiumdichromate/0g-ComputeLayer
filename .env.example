PORT=4100
# Base URL used in sprite/cover/game URLs returned to clients.
PUBLIC_BASE_URL=http://localhost:4100
# Shared secret creator-studio sends as the x-compute-key header. Unset = open (dev only).
COMPUTE_API_KEY=

# 0G Compute router. With no key (or LLM_MOCK=1) the layer runs on a deterministic
# mock provider so the whole pipeline can be exercised offline.
ZERO_G_API_KEY=
ZERO_G_BASE_URL=https://router-api.0g.ai/v1
LLM_MOCK=

# Where runs, artifacts and the harvested library live.
DATA_DIR=./data
RUN_CONCURRENCY=6
APPROVAL_TIMEOUT_MS=900000

# Chrome/Edge for the browser playtest (auto-detected on Windows/macOS/Linux).
PLAYTEST_BROWSER_PATH=

# Per-agent model overrides: AGENT_<ROLE>_TIER<n>
# roles: BRIEF DESIGNER ART_DIRECTOR ILLUSTRATOR ENGINEER REPAIR JUDGE COPYWRITER EDIT_ROUTER IMAGE
# AGENT_ENGINEER_TIER3=claude-opus-5
# AGENT_JUDGE_TIER2=qwen3.7-plus

# Per-tier feature overrides: TIER<n>_<FEATURE>
# SPRITES=none|svg|image  ENVIRONMENT=none|image  COVER=none|image  PLAYTEST=true|false
# REPAIR_ATTEMPTS=n  MAX_SPRITES=n
# TIER1_SPRITES=svg
# TIER1_MAX_SPRITES=3
